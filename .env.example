# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# SQLite for local dev. For production switch the Prisma provider to postgresql.
DATABASE_URL="file:./dev.db"
